# Build-time, PUBLIC values — everything here is inlined into the JS bundle.
# NEVER put a secret in a VITE_ variable.

# Empty = same origin (production: nginx serves page and API together).
VITE_API_BASE=

# Public half of the reCAPTCHA pair. Dev builds fall back to Google's
# universal test key when unset; production MUST set the real one
# (Bitwarden: "Avni Signup Google Recaptcha").
VITE_RECAPTCHA_SITEKEY=

VITE_BUGSNAG_KEY=

# Same PostHog project as avni-webapp (public by design).
VITE_POSTHOG_KEY=phc_yLIQYtQjgTZJOl7ocZC9b26ruoWQCGYkLKUaqvOZN8s

# Set to 0 to disable the built-in dev API mock and proxy /api to the real
# service on 127.0.0.1:4000 (make web-start-with-server does this).
# VITE_API_MOCK=0
