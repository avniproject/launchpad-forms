{
  "name": "launchpad-forms-server",
  "version": "0.1.0",
  "private": true,
  "description": "Credential-holding service between the Launchpad signup page and the Avni external API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bugsnag/js": "^8.0.0",
    "fastify": "^5.0.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^25.8.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "nock": "^14.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
