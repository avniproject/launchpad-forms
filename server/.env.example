# launchpad-forms service. Copy to .env for local dev (dev script does NOT
# auto-load it — run: env $(cat .env | xargs) npm run dev, or use direnv).
# In deployment these come from /etc/launchpad-forms.conf (Ansible-vaulted).

PORT=4000

# Avni — the hosted service; org is selected by the user below.
AVNI_BASE_URL=https://app.avniproject.org
# UAT: apiuser@launchpadUat (capital U) · prod: apiuser@launchpad.
# The user needs "Is Allowed To Invoke Token Generation API" ON, group
# "API Integration", and one browser login done to clear the forced
# password change.
AVNI_USERNAME=apiuser@launchpadUat
AVNI_PASSWORD=

# reCAPTCHA v2. Secret pairs with the site key the page was built with
# (Bitwarden: "Avni Signup Google Recaptcha"). For local dev use Google's
# universal TEST pair — always passes:
#   secret  6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
#   sitekey 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI (the web app's dev default)
RECAPTCHA_SECRET=
# UAT only — lets smoke.sh submit without a browser. MUST be empty on prod.
RECAPTCHA_BYPASS_TOKEN=

BUGSNAG_KEY=
# Bugsnag releaseStage. NODE_ENV is `production` on UAT too, so set this
# explicitly per instance: uat | prod.
RELEASE_STAGE=development

# The cohort every submission enrols into — must match the Cohort concept's
# coded answer name in the App Designer, verbatim. Cohort 4 runs in more than
# one region, so the answer is deliberately just "Cohort 4" (regional
# breakdown comes from the State observation instead).
COHORT=Cohort 4
REG_OPEN=
REG_CLOSE=2026-10-05T23:59:59+05:30

# Exact names as configured in the App Designer (UAT org, 8 Sep).
SUBJECT_TYPE=Organisation
PROGRAM=Launchpad Application
ADDRESS=India

DEAD_LETTER_PATH=/var/lib/launchpad-forms/dead-letter.jsonl
LOG_LEVEL=info
